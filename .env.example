# All variables below are optional — the app runs and builds with none of them set,
# falling back to the defaults in src/lib/core/core-system.ts. Set any of these to
# rebrand a fork (your own repo/site links, vendor name, logo, contact info, etc.).

VITE_GITHUB_URL=
VITE_YOUTUBE_URL=
VITE_YOUTUBE_PLAYLIST_URL=
VITE_DOWNLOAD_URL=
VITE_VENDOR_LOGO=
VITE_BRAND_LOGO=
VITE_VENDOR_NAME=
VITE_VENDOR_URL=
VITE_VENDOR_EMAIL=
VITE_BASE_URL=

# Set to "true" only for the official production deployment.
VITE_IS_OFFICIAL=
